zn "%SYS"

    // Simple dev credentials. Do not do this in production.
    do ##class(Security.Users).UnExpireUserPasswords("*")

    // Enable callin for Embedded Python / external tooling
    do ##class(Security.Services).Get("%Service_CallIn",.prop)
    set prop("Enabled")=1
    set prop("AutheEnabled")=48
    do ##class(Security.Services).Modify("%Service_CallIn",.prop)

    zn "WECHAT"

    // Compile runtime sources only; test assets live outside src and stay out of the image.
    set sc=$system.OBJ.LoadDir("/home/irisowner/dev/src","ck",,1)
    if $system.Status.IsError(sc) do $system.Status.DisplayError(sc) halt

    // Register the demo production and its settings
    set sc=##class(WeChat.Util.Setup).Setup()
    if $system.Status.IsError(sc) do $system.Status.DisplayError(sc) halt

    // Validate the production definition (start + stop once)
    set sc=##class(WeChat.Util.Setup).Smoke()
    if $system.Status.IsError(sc) do $system.Status.DisplayError(sc) halt

    write !,"WECHAT_BUILD_OK=1",!
    halt
