# Optional override. Default: InterSystems IRIS for Health Community 2026.2.
IRIS_IMAGE=intersystems/irishealth-community:2026.2

# Real WeCom credentials (optional). The demo production ships with fake
# placeholder values; configure real ones in the Production or via credentials.
# Never commit real values. WECOM_ROBOT_KEY is a high-risk credential: the official
# docs warn that a leaked webhook URL lets anyone post into your group.
# WECOM_CORPID=
# WECOM_CORPSECRET=
# WECOM_AGENTID=
# WECOM_ROBOT_KEY=
# WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
